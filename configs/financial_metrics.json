{
    "_readme": [
        "Financial metrics used by 2-generate-questions.py --mode metrics (see configs/economics_question.md).",
        "formula: Python-like expression over spreadsheet columns (configs/concept_metadata.json) and other metrics.",
        "  + - * / ** and numbers are allowed; name[-1] means the value one year earlier.",
        "unit: amount (millions USD) | percent (answer as a decimal) | multiple | per_share (USD) | days",
        "tier: the tier in economics_question.md; helper metrics (net_income, ...) get the tier of their depth.",
        "convention (optional): added to named questions to fix an ambiguous definition without giving the formula."
    ],
    "define": {
        "gross_profit":            {"label": "gross profit",            "tier": 1, "unit": "amount",    "formula": "revenue - cost_of_goods_sold"},
        "operating_income":        {"label": "operating income",        "tier": 1, "unit": "amount",    "formula": "gross_profit - operating_expenses"},
        "pretax_income":           {"label": "pretax income",           "tier": 1, "unit": "amount",    "formula": "operating_income - non_operating_expenses"},
        "income_tax_expense":      {"label": "income tax expense",      "tier": 1, "unit": "amount",    "formula": "pretax_income * income_tax"},
        "net_income":              {"label": "net income",              "tier": 1, "unit": "amount",    "formula": "pretax_income - income_tax_expense"},
        "current_assets":          {"label": "current assets",          "tier": 1, "unit": "amount",    "formula": "cash + short_term_investments + accounts_receivable + inventories"},
        "working_capital":         {"label": "working capital",         "tier": 1, "unit": "amount",    "formula": "current_assets - current_liabilities"},
        "book_value_of_equity":    {"label": "book value of equity",    "tier": 1, "unit": "amount",    "formula": "total_assets - total_liabilities"},
        "market_capitalization":   {"label": "market capitalization",   "tier": 1, "unit": "amount",    "formula": "stock_price * shares_outstanding"},

        "current_ratio":           {"label": "current ratio",           "tier": 2, "unit": "multiple",  "formula": "current_assets / current_liabilities"},
        "debt_ratio":              {"label": "debt ratio",              "tier": 2, "unit": "percent",   "formula": "total_liabilities / total_assets",
                                    "convention": "Count all liabilities as debt."},
        "equity_multiplier":       {"label": "equity multiplier",       "tier": 2, "unit": "multiple",  "formula": "total_assets / total_equity"},
        "net_margin":              {"label": "net margin",              "tier": 2, "unit": "percent",   "formula": "net_income / revenue"},
        "asset_turnover":          {"label": "asset turnover",          "tier": 2, "unit": "multiple",  "formula": "revenue / total_assets"},
        "eps":                     {"label": "earnings per share",      "tier": 2, "unit": "per_share", "formula": "net_income / shares_outstanding"},
        "payout_ratio":            {"label": "dividend payout ratio",   "tier": 2, "unit": "percent",   "formula": "dividends_paid / net_income"},
        "capex_intensity":         {"label": "capex intensity",         "tier": 2, "unit": "percent",   "formula": "capex / revenue"},
        "effective_tax_rate":      {"label": "effective tax rate",      "tier": 2, "unit": "percent",   "formula": "income_tax_expense / pretax_income"},
        "gross_margin":            {"label": "gross margin",            "tier": 2, "unit": "percent",   "formula": "gross_profit / revenue"},
        "cash_ratio":              {"label": "cash ratio",              "tier": 2, "unit": "multiple",  "formula": "(cash + short_term_investments) / current_liabilities"},
        "quick_ratio":             {"label": "quick ratio",             "tier": 2, "unit": "multiple",  "formula": "(cash + short_term_investments + accounts_receivable) / current_liabilities"},
        "pe_ratio":                {"label": "price-to-earnings ratio", "tier": 2, "unit": "multiple",  "formula": "stock_price / eps"},
        "pb_ratio":                {"label": "price-to-book ratio",     "tier": 2, "unit": "multiple",  "formula": "market_capitalization / total_equity"},
        "dividend_yield":          {"label": "dividend yield",          "tier": 2, "unit": "percent",   "formula": "dividends_paid / shares_outstanding / stock_price"},

        "roa":                     {"label": "return on average assets", "tier": 3, "unit": "percent",  "formula": "net_income / ((total_assets + total_assets[-1]) / 2)",
                                    "convention": "Average assets = mean of this year-end and the previous year-end."},
        "roe":                     {"label": "return on average equity", "tier": 3, "unit": "percent",  "formula": "net_income / ((total_equity + total_equity[-1]) / 2)",
                                    "convention": "Average equity = mean of this year-end and the previous year-end."},
        "inventory_turnover":      {"label": "inventory turnover",      "tier": 3, "unit": "multiple",  "formula": "cost_of_goods_sold / ((inventories + inventories[-1]) / 2)",
                                    "convention": "Use average inventory (mean of this year-end and the previous year-end)."},
        "receivables_turnover":    {"label": "receivables turnover",    "tier": 3, "unit": "multiple",  "formula": "revenue / ((accounts_receivable + accounts_receivable[-1]) / 2)",
                                    "convention": "Use average receivables (mean of this year-end and the previous year-end)."},
        "change_in_working_capital": {"label": "change in working capital", "tier": 3, "unit": "amount", "formula": "working_capital - working_capital[-1]"},
        "gross_margin_change":     {"label": "year-over-year change in gross margin", "tier": 3, "unit": "percent", "formula": "gross_margin - gross_margin[-1]"},
        "revenue_vs_cost_growth":  {"label": "gap between revenue growth and cost of goods sold growth", "tier": 3, "unit": "percent",
                                    "formula": "(revenue - revenue[-1]) / revenue[-1] - (cost_of_goods_sold - cost_of_goods_sold[-1]) / cost_of_goods_sold[-1]"},

        "operating_margin":        {"label": "operating margin",        "tier": 4, "unit": "percent",   "formula": "operating_income / revenue"},
        "nopat":                   {"label": "net operating profit after tax (NOPAT)", "tier": 4, "unit": "amount", "formula": "operating_income * (1 - income_tax)",
                                    "convention": "Use the income tax rate from the spreadsheet as the tax rate."},
        "dio":                     {"label": "days inventory outstanding", "tier": 4, "unit": "days",   "formula": "(inventories + inventories[-1]) / 2 / cost_of_goods_sold * 365",
                                    "convention": "Use average inventory (mean of this year-end and the previous year-end) and a 365-day year."},
        "dso":                     {"label": "days sales outstanding",  "tier": 4, "unit": "days",      "formula": "(accounts_receivable + accounts_receivable[-1]) / 2 / revenue * 365",
                                    "convention": "Use average receivables (mean of this year-end and the previous year-end) and a 365-day year."},
        "incremental_operating_margin": {"label": "incremental operating margin", "tier": 4, "unit": "percent",
                                    "formula": "(operating_income - operating_income[-1]) / (revenue - revenue[-1])",
                                    "convention": "Compare with the previous year."},
        "operating_margin_change": {"label": "year-over-year change in operating margin", "tier": 4, "unit": "percent", "formula": "operating_margin - operating_margin[-1]"},

        "dupont_roe":              {"label": "return on equity (3-step DuPont)", "tier": 5, "unit": "percent", "formula": "net_margin * asset_turnover * equity_multiplier",
                                    "convention": "Use year-end balances."},
        "sustainable_growth_rate": {"label": "sustainable growth rate", "tier": 5, "unit": "percent",   "formula": "roe * (1 - payout_ratio)",
                                    "convention": "Use return on average equity (mean of this year-end and the previous year-end equity)."}
    }
}
